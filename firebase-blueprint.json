{
  "entities": {
    "lead": {
      "title": "Customer Lead",
      "description": "Information about a potential customer interested in a vehicle.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "interest": { "type": "string" },
        "carRequested": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "chat_session": {
      "title": "Chat Session",
      "description": "Stored chat history for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "messages": { "type": "array", "items": { "type": "object" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "updatedAt"]
    }
  },
  "firestore": {
    "/leads/{leadId}": {
      "schema": "lead",
      "description": "Collection of customer leads."
    },
    "/chats/{chatId}": {
      "schema": "chat_session",
      "description": "Collection of chat sessions for persistent connections."
    }
  }
}
